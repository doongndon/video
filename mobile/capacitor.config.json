{
  "appId": "io.github.doongndon.montage",
  "appName": "Montage",
  "webDir": "www",
  "backgroundColor": "#15171b",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
