{
  "name": "montage-desktop",
  "productName": "Montage",
  "version": "1.0.0",
  "description": "Montage 영상·사진 편집기 (데스크톱 앱)",
  "author": "Montage",
  "license": "MPL-2.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.doongndon.montage",
    "productName": "Montage",
    "files": ["main.js", "icon.png", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "icon": "icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Montage",
      "artifactName": "Montage-Setup-${version}.exe"
    },
    "portable": { "artifactName": "Montage-${version}-portable.exe" }
  }
}
